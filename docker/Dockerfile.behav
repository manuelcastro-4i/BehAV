# BehAV Navigation System Docker Image
# Base: NVIDIA CUDA with Ubuntu 22.04 for ROS2 Humble
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set locale
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    gnupg2 \
    lsb-release \
    wget \
    git \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Add ROS2 Humble repository (LTS, compatible with Ubuntu 22.04)
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS2 Humble base and required packages
RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-std-msgs \
    ros-humble-image-transport \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-foxglove-bridge \
    ros-humble-rviz2 \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for BehAV
RUN pip3 install --no-cache-dir \
    torch==2.1.0 \
    torchvision==0.16.0 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip3 install --no-cache-dir \
    "numpy>=1.24.0,<2.0.0" \
    "transformers>=4.30.0,<4.40.0" \
    opencv-python>=4.8.0 \
    opencv-python-headless>=4.8.0 \
    scipy>=1.10.0 \
    scikit-image>=0.21.0 \
    matplotlib>=3.7.0 \
    pillow>=10.0.0 \
    openai>=1.0.0 \
    requests>=2.31.0 \
    nlopt>=2.7.0 \
    cma>=3.3.0

# Install ultralytics (required by FastSAM for landmark detection)
RUN pip3 install --no-cache-dir --timeout 300 --retries 5 ultralytics>=8.0.0

# Clone FastSAM repository (required by landmark_detector_ROS2.py)
RUN git clone https://github.com/CASIA-IVA-Lab/FastSAM.git /app/FastSAM

# Set up workspace
WORKDIR /app

# Copy BehAV source code
COPY planning/ /app/planning/
COPY landmark-tracking/ /app/landmark-tracking/
COPY instruction-decomposition/ /app/instruction-decomposition/
COPY config/ /app/config/

# Create models directory (models are mounted as volume)
RUN mkdir -p /app/models

# Set environment variables
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV PYTHONPATH=/opt/ros/humble/local/lib/python3.10/dist-packages:/opt/ros/humble/lib/python3.10/site-packages:/app:/app/FastSAM:$PYTHONPATH \
    LD_LIBRARY_PATH=/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib:$LD_LIBRARY_PATH \
    AMENT_PREFIX_PATH=/opt/ros/humble

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "/app/planning/behav-planner.py"]
