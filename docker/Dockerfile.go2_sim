# Go2 Robot Simulator Docker Image
# Based on ROS2 Jazzy with Gazebo Harmonic
# Supports headless (default) and noVNC modes for cross-platform use
FROM osrf/ros:jazzy-desktop

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Gazebo Harmonic via ros-jazzy-ros-gz (not gazebo-ros-pkgs which is Classic)
RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-gz \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rviz2 \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-nav2-common \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install noVNC and virtual display dependencies
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    fluxbox \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /app

# Clone go2_ros2_sim_py repository
RUN git clone https://github.com/abutalipovvv/go2_ros2_sim_py.git /app/go2_sim

# Build the workspace
WORKDIR /app/go2_sim
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install

# Workarounds for upstream path bugs in go2_ros2_sim_py:
# 1. gazebo_sim launch references xacro/ from its own share, but it lives in go2_description
RUN ln -s /app/go2_sim/install/go2_description/share/go2_description/xacro \
    /app/go2_sim/install/gazebo_sim/share/gazebo_sim/xacro
# 2. rviz_launch.py looks for .rviz in config/ but it's installed in rviz/
RUN ln -s /app/go2_sim/install/gazebo_sim/share/gazebo_sim/rviz/multi_nav2_default_view.rviz \
    /app/go2_sim/install/gazebo_sim/share/gazebo_sim/config/multi_nav2_default_view.rviz
# 3. launch_sim.launch.py references empty.world but only cafe.world exists
COPY docker/empty.world /app/go2_sim/install/gazebo_sim/share/gazebo_sim/world/empty.world

# Set environment variables
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV DISPLAY=:99

# Expose VNC and noVNC ports
EXPOSE 5900 6080

# Copy entrypoint script
COPY docker/entrypoint_sim.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "gazebo_sim", "launch_sim.launch.py"]
