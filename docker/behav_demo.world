<?xml version="1.0" ?>
<!--
  BehAV Demo World — Gazebo Harmonic (SDF 1.9)

  S-curve path layout (bird's-eye, robot spawns at origin facing +X):

    y+
    |         ________
    |        /   seg2  \   [peak y=+2.5 at x=9]
    | [seg1]/            \[seg3]
    +-------              -------[seg4]---[GOAL x=17]---> x+
   robot(0,0)                                 goal(17,0)

  Path: 4 asphalt box segments + junction patches → S-curve
    Seg1: (0,0)→(4,0)       center=(2,0)       rot=0
    Seg2: (4,0)→(9,2.5)     center=(6.5,1.25)  rot=+0.4636 rad (+26.6°)
    Seg3: (9,2.5)→(14,0)    center=(11.5,1.25) rot=-0.4636 rad (-26.6°)
    Seg4: (14,0)→(17,0)     center=(15.5,0)    rot=0
  All segments: 3 m wide, 0.01 m thick, raised 5 mm above grass.

  CLIPSeg semantics (optimizer MINIMIZES total_cost):
    "pavement"   cost=0.1 → LOW penalty  → preferred (robot stays on road)
    "green grass" cost=0.9 → HIGH penalty → penalized  (robot avoids grass)
-->
<sdf version="1.9">
  <world name="empty">

    <!-- ── Core physics / rendering plugins ─────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ── Lighting ─────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0.3 0.3</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.6 0.2 -0.8</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light type="directional" name="ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 -0.3 1.5</pose>
      <diffuse>0.4 0.5 0.55 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.3 -0.1 -0.9</direction>
    </light>

    <!-- ── Physics ──────────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══════════════════════════════════════════════════════════════════
         GROUND — Green grass (large flat plane)
    ════════════════════════════════════════════════════════════════════ -->
    <model name="grass_ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.13 0.42 0.10 1</ambient>
            <diffuse>0.18 0.55 0.14 1</diffuse>
            <specular>0.02 0.06 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         S-CURVE ASPHALT PATH
         Dark gray (0.22/0.30), 3 m wide, 0.01 m thick, z=0.005
    ════════════════════════════════════════════════════════════════════ -->

    <!-- Seg1: straight, (0,0)→(4,0), length=4m -->
    <model name="path_seg1">
      <static>true</static>
      <pose>2 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 3.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Junction patch at P1=(4,0) fills corner gap between seg1 and seg2 -->
    <model name="path_junc1">
      <static>true</static>
      <pose>4 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.5 3.0 0.01</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg2: curve up-right, (4,0)→(9,2.5), length=5.59m, rot=+26.6° -->
    <model name="path_seg2">
      <static>true</static>
      <pose>6.5 1.25 0.005 0 0 0.4636</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.59 3.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.59 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Junction patch at P2=(9,2.5) -->
    <model name="path_junc2">
      <static>true</static>
      <pose>9 2.5 0.005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.5 3.0 0.01</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg3: curve down-right, (9,2.5)→(14,0), length=5.59m, rot=-26.6° -->
    <model name="path_seg3">
      <static>true</static>
      <pose>11.5 1.25 0.005 0 0 -0.4636</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.59 3.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.59 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Junction patch at P3=(14,0) -->
    <model name="path_junc3">
      <static>true</static>
      <pose>14 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.5 3.0 0.01</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.5 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seg4: straight end, (14,0)→(17,0), length=3m -->
    <model name="path_seg4">
      <static>true</static>
      <pose>15.5 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3.0 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3.0 0.01</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- White centre-line dashes along each segment -->
    <model name="dash_1"><static>true</static><pose>1.5 0 0.012 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.8 0.12 0.001</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual></link>
    </model>
    <model name="dash_2"><static>true</static><pose>3.0 0 0.012 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.8 0.12 0.001</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual></link>
    </model>
    <!-- dash at centre of seg2 -->
    <model name="dash_3"><static>true</static><pose>6.5 1.25 0.012 0 0 0.4636</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.8 0.12 0.001</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual></link>
    </model>
    <!-- dash at centre of seg3 -->
    <model name="dash_4"><static>true</static><pose>11.5 1.25 0.012 0 0 -0.4636</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.8 0.12 0.001</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual></link>
    </model>
    <!-- dashes on seg4 -->
    <model name="dash_5"><static>true</static><pose>15.0 0 0.012 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.8 0.12 0.001</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual></link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         OBSTACLES — concrete boxes with collision, placed in/near path
    ════════════════════════════════════════════════════════════════════ -->

    <!-- Obstacle 1: left side of seg1, forces robot to hug right at start -->
    <model name="obstacle_seg1_left">
      <static>true</static>
      <pose>3.0 0.9 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.42 1</ambient>
            <diffuse>0.62 0.57 0.47 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: at peak of S-curve, right side — forces robot left through curve -->
    <model name="obstacle_apex_right">
      <static>true</static>
      <pose>9.0 1.7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.42 1</ambient>
            <diffuse>0.62 0.57 0.47 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: left side of seg4, near goal -->
    <model name="obstacle_seg4_left">
      <static>true</static>
      <pose>15.5 0.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.55 0.50 0.42 1</ambient>
            <diffuse>0.62 0.57 0.47 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         GOAL MARKER — bright red pole + yellow cap at x=17, y=0
    ════════════════════════════════════════════════════════════════════ -->
    <model name="goal_marker">
      <static>true</static>
      <pose>17.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="pole">
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.08 0.05 1</ambient>
            <diffuse>0.95 0.10 0.05 1</diffuse>
            <specular>0.3 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="goal_cap">
      <static>true</static>
      <pose>17.0 0 1.52 0 0 0</pose>
      <link name="link">
        <visual name="cap">
          <geometry><cylinder><radius>0.30</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.85 0.0 1</ambient>
            <diffuse>1.0 0.90 0.0 1</diffuse>
            <specular>0.4 0.4 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         TREES — green spheres on brown trunks along the S-curve
    ════════════════════════════════════════════════════════════════════ -->

    <!-- Near start, left side -->
    <model name="tree_l1"><static>true</static><pose>1.5 4.0 0 0 0 0</pose>
      <link name="trunk"><visual name="v"><pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.10 1</ambient><diffuse>0.40 0.25 0.12 1</diffuse></material>
      </visual></link>
    </model>
    <model name="tree_l1_top"><static>true</static><pose>1.5 4.0 2.3 0 0 0</pose>
      <link name="leaves"><visual name="v">
        <geometry><sphere><radius>1.1</radius></sphere></geometry>
        <material><ambient>0.10 0.40 0.08 1</ambient><diffuse>0.12 0.48 0.10 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Near start, right side -->
    <model name="tree_r1"><static>true</static><pose>2.0 -4.0 0 0 0 0</pose>
      <link name="trunk"><visual name="v"><pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.10 1</ambient><diffuse>0.40 0.25 0.12 1</diffuse></material>
      </visual></link>
    </model>
    <model name="tree_r1_top"><static>true</static><pose>2.0 -4.0 2.3 0 0 0</pose>
      <link name="leaves"><visual name="v">
        <geometry><sphere><radius>1.0</radius></sphere></geometry>
        <material><ambient>0.10 0.40 0.08 1</ambient><diffuse>0.12 0.48 0.10 1</diffuse></material>
      </visual></link>
    </model>

    <!-- At S-curve peak, outer left side -->
    <model name="tree_peak_l"><static>true</static><pose>9.0 6.0 0 0 0 0</pose>
      <link name="trunk"><visual name="v"><pose>0 0 1.0 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>2.0</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.10 1</ambient><diffuse>0.40 0.25 0.12 1</diffuse></material>
      </visual></link>
    </model>
    <model name="tree_peak_l_top"><static>true</static><pose>9.0 6.0 2.6 0 0 0</pose>
      <link name="leaves"><visual name="v">
        <geometry><sphere><radius>1.2</radius></sphere></geometry>
        <material><ambient>0.08 0.38 0.07 1</ambient><diffuse>0.10 0.45 0.09 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Below S-curve, right side -->
    <model name="tree_r2"><static>true</static><pose>7.0 -4.0 0 0 0 0</pose>
      <link name="trunk"><visual name="v"><pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.10 1</ambient><diffuse>0.40 0.25 0.12 1</diffuse></material>
      </visual></link>
    </model>
    <model name="tree_r2_top"><static>true</static><pose>7.0 -4.0 2.3 0 0 0</pose>
      <link name="leaves"><visual name="v">
        <geometry><sphere><radius>1.1</radius></sphere></geometry>
        <material><ambient>0.10 0.40 0.08 1</ambient><diffuse>0.12 0.48 0.10 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Near goal, right framing -->
    <model name="tree_goal"><static>true</static><pose>17.0 3.5 0 0 0 0</pose>
      <link name="trunk"><visual name="v"><pose>0 0 1.1 0 0 0</pose>
        <geometry><cylinder><radius>0.20</radius><length>2.2</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.10 1</ambient><diffuse>0.40 0.25 0.12 1</diffuse></material>
      </visual></link>
    </model>
    <model name="tree_goal_top"><static>true</static><pose>17.0 3.5 2.8 0 0 0</pose>
      <link name="leaves"><visual name="v">
        <geometry><sphere><radius>1.3</radius></sphere></geometry>
        <material><ambient>0.09 0.38 0.07 1</ambient><diffuse>0.11 0.45 0.09 1</diffuse></material>
      </visual></link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         PATH KERBS — low white borders on straight segments
    ════════════════════════════════════════════════════════════════════ -->
    <model name="kerb_seg1_left">
      <static>true</static>
      <pose>2 1.55 0.04 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.10 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 0.10 0.08</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="kerb_seg1_right">
      <static>true</static>
      <pose>2 -1.55 0.04 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.10 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 0.10 0.08</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="kerb_seg4_left">
      <static>true</static>
      <pose>15.5 1.55 0.04 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.10 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.10 0.08</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="kerb_seg4_right">
      <static>true</static>
      <pose>15.5 -1.55 0.04 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.10 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.10 0.08</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
